{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "atlas",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "atlas.server",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "atlas-public",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "atlas/data/public"
      ],
      "port": 8766
    },
    {
      "name": "atlas-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "atlas/web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}
